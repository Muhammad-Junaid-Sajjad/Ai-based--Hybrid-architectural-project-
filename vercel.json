{
  "version": 2,
  "name": "hybrid-cpu-architecture",
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
